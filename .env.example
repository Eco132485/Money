# ISA AUTO TRADING — zero-cost configuration
# PAPER TRADING ONLY. Real capital is always $0; virtual starting equity is $1,000.
TRADING_MODE=paper
EXCHANGE=kraken
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT
FOREX_SYMBOLS=EURUSD,GBPUSD
TIMEFRAME=1h
LOOP_INTERVAL_SEC=60
INITIAL_BALANCE=1000
DB_PATH=data/trading.db
LOG_LEVEL=INFO

# Gemini 3.8 Flash. Use a Google AI Studio FREE-TIER project only.
# Do not link billing or enable paid tier. If free tier is unavailable, AI trades pause.
ISA_GEMINI_API_KEY=
ISA_GEMINI_FREE_TIER_CONFIRMED=false
LLM_MAX_TOKENS=800

# Widowmaker prompt optimisation is always active in the trading analysis path.
# Optional independent Ollama review. When enabled, disagreement/unavailable output means HOLD.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_SECONDS=20

# Optional Kronos forecasting via an owner-operated HTTPS wrapper service.
# Kronos has no universal hosted API URL; see docs/AI_INTEGRATIONS.md for the request/response contract.
KRONOS_ENABLED=false
KRONOS_REQUIRED=false
KRONOS_API_URL=
KRONOS_API_KEY=
KRONOS_TIMEOUT_SECONDS=15

# Shared server-side risk limits
MAX_POSITION_PCT=0.30
MAX_PORTFOLIO_EXPOSURE_PCT=0.30
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.15
RISK_PER_TRADE_PCT=0.01
MIN_CONFIDENCE=0.55
MAX_OPEN_POSITIONS=5

# Optional notifications disabled by default; no paid integrations.
NOTIFICATIONS_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
