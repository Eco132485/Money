# ============================================================
# Autonomous Trading Agent — environment configuration
# Copy to .env and fill in. NEVER commit .env to version control.
# ============================================================

# ---- Runtime ----
TRADING_MODE=paper            # paper | live
SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAME=1h
LOOP_INTERVAL_SEC=60
INITIAL_BALANCE=10000
LOG_LEVEL=INFO
DB_PATH=data/trading.db

# ---- Exchange ----
EXCHANGE=binance              # binance | binanceus | bybit | kraken | coinbase
MARKET_TYPE=spot              # spot | futures
EXCHANGE_BASE_URL=https://api.binance.com   # use https://api.binance.us if geo-blocked
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=true
QUOTE_ASSET=USDT

# ---- Risk (hard limits, enforced before every order) ----
MAX_POSITION_PCT=0.02         # 2% of equity per trade
MAX_PORTFOLIO_EXPOSURE_PCT=0.30
MAX_DAILY_LOSS_PCT=0.03       # 3% daily loss limit
MAX_DRAWDOWN_PCT=0.15         # 15% peak-to-trough
STOP_LOSS_PCT=0.015
TAKE_PROFIT_PCT=0.03
MIN_CONFIDENCE=0.55
MAX_OPEN_POSITIONS=5
RISK_PER_TRADE_PCT=0.01
KILL_SWITCH_ENABLED=true

# ---- LLM (optional; provider-agnostic) ----
LLM_ENABLED=false
LLM_PROVIDER=rule             # rule | openai | anthropic
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

# ---- Notifications (optional) ----
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---- Dashboard ----
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
